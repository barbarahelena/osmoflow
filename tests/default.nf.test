nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    // Output file names are snapshotted for every file except run-specific ones (timestamped
    // reports, params dump) and the downloaded database, whose folder name is the release.
    // File contents are snapshotted only for files that do not depend on the osmo_refdb release
    // or on the run (see tests/.nftignore): the osmotool tables change with every new release
    // the test profile downloads.
    def ignore_names = [ 'pipeline_info/*.{html,json,txt}', 'database/**' ]

    test("-profile test") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ignore_names)
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                // a unit on report level none is NA in every sample, never 0 (not reliable on short reads)
                { assert path("$outputDir/profile/profile_unit_raw_count.tsv").readLines()
                    .find { line -> line.startsWith('opuAC\t') }
                    .tokenize('\t').drop(1).every { value -> value == 'NA' } },
                // the same for annotate's unit table (osmo_refdb v11+: annotate report levels)
                { assert path("$outputDir/annotate/annotate_unit_raw_count.tsv").readLines()
                    .find { line -> line.startsWith('opuAC\t') }
                    .tokenize('\t').drop(1).every { value -> value == 'NA' } },
                { assert snapshot(
                    // software versions, without the Nextflow version: tests may run on several Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/osmoflow_software_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test with all preprocessing") {

        when {
            params {
                outdir         = "$outputDir"
                fastp          = true
                host_fasta     = "${projectDir}/assets/test/assembly.fasta"
                subsamplelevel = 1
                readcounts     = true
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ignore_names)
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                // both test reads pass fastp (length_required lowered in conf/test.config),
                // none map to the 'host', and subsampling keeps one
                { assert path("$outputDir/readcounts/readcounts.csv").readLines() == [
                    'sample,stage,reads',
                    'TEST_PAIRED,final,1',
                    'TEST_PAIRED,raw,2',
                    'TEST_SINGLE,final,1',
                    'TEST_SINGLE,raw,2'
                ] },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/osmoflow_software_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test with run merging") {

        when {
            params {
                outdir             = "$outputDir"
                input              = "${projectDir}/assets/test/samplesheet_runmerging.csv"
                perform_runmerging = true
                fastp              = true
                host_fasta         = "${projectDir}/assets/test/assembly.fasta"
                readcounts         = true
            }
        }

        then {
            def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: ignore_names)
            def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert workflow.success },
                // two runs of two reads (pairs) per sample: the raw counts of the runs are added up,
                // and the merged reads (no subsampling) have all four
                { assert path("$outputDir/readcounts/readcounts.csv").readLines() == [
                    'sample,stage,reads',
                    'TEST_PAIRED,final,4',
                    'TEST_PAIRED,raw,4',
                    'TEST_SINGLE,final,4',
                    'TEST_SINGLE,raw,4'
                ] },
                { assert snapshot(
                    removeNextflowVersion("$outputDir/pipeline_info/osmoflow_software_versions.yml"),
                    stable_name,
                    stable_path
                ).match() }
            )
        }
    }

    test("-profile test, osmo_refdb release without report levels -stub") {

        options "-stub"

        when {
            params {
                outdir  = "$outputDir"
                osmo_db = "${projectDir}/assets/test/refdb_no_report_levels"
            }
        }

        then {
            // stops once, before profiling, with a message that names the requirement
            assertAll(
                { assert workflow.failed },
                { assert (workflow.stdout + workflow.stderr).any { line -> line.contains('needs osmo_refdb v10 or later') } }
            )
        }
    }
}
