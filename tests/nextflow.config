/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

params {
    // Use a local osmo_refdb release instead of downloading one: OSMO_DB=/path/to/osmo_refdb/<release> nf-test test
    // The snapshot is recorded against v11, the first release with annotate report levels (annotate's unit tables):
    // set OSMO_DB to a v11 release. Without it the tests download 'latest', which is v10 until v11 is on Zenodo.
    osmo_db = System.getenv('OSMO_DB') ?: null

    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/osmoflow'
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners
