/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withLabel: 'bowtie2' {
        conda      = 'bioconda::bowtie2=2.5.2 bioconda::samtools=1.18 conda-forge::pigz=2.6'
        container  = 'biocontainers/mulled-v2-ac74a7f02cebcfcc07d8e8d1d750af9c83b4d45a:f70b31a2db15c023d641c32f433fb02cd04df5a6-0'
    }

    withLabel: 'cat' {
        conda      = 'conda-forge::coreutils=9.4'
        container  = {
            workflow.containerEngine == 'singularity' && !task.ext.singularity_pull_docker_container
                ? 'https://depot.galaxyproject.org/singularity/ubuntu:22.04'
                : 'nf-core/ubuntu:22.04'
        }
    }

    withLabel: 'fastp' {
        conda      = 'bioconda::fastp=1.0.1'
        container  = 'biocontainers/fastp:1.0.1--heae3180_0'
    }

    withLabel: 'seqkit' {
        conda      = 'bioconda::seqkit=2.9.0'
        container  = 'biocontainers/seqkit:2.9.0--h9ee0642_0'
    }

    withName: 'FASTP' {
        ext.args   = '--cut_right --cut_window_size 4 --cut_mean_quality 15 --length_required 70'
        publishDir = [
            path: { "${params.outdir}/fastp" },
            mode: params.publish_dir_mode,
            pattern: '*.{json,html,log}'
        ]
    }

    withName: 'BOWTIE2_FILTERHOST' {
        publishDir = [
            path: { "${params.outdir}/bowtie2" },
            mode: params.publish_dir_mode,
            pattern: '*.{log,stats}'
        ]
    }

    withName: 'BOWTIE2_BUILD|CAT_FASTQ|SEQKIT_SAMPLE|READCOUNT_.*' {
        publishDir = [ enabled: false ]
    }

    withName: 'WRITE_READCOUNTS' {
        publishDir = [
            path: { "${params.outdir}/readcounts" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'WRITE_VERSIONS' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode
        ]
    }

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode
    ]

    withName: 'OSMOTOOL_DOWNLOAD_DB' {
        publishDir = [
            path: { "${params.outdir}/database" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'OSMOTOOL_PROFILE' {
        cpus   = { 4     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 2.h   * task.attempt }
        publishDir = [
            path: { "${params.outdir}/profile/${id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'OSMOTOOL_ANNOTATE' {
        cpus   = { 2     * task.attempt }
        memory = { 4.GB  * task.attempt }
        time   = { 30.m * task.attempt }
        publishDir = [
            path: { "${params.outdir}/annotate/${id}" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'OSMOTOOL_MERGE_COUNTS' {
        publishDir = [
            path: { "${params.outdir}/${mode}" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'OSMOTOOL_MERGE_SYSTEMS' {
        publishDir = [
            path: { "${params.outdir}/annotate" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'OSMOTOOL_MERGE_GENE_COORDINATES' {
        publishDir = [
            path: { "${params.outdir}/annotate" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

}
