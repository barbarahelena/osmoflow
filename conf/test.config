/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run barbarahelena/osmoflow -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]

    // The test reads are 48 bp: lower fastp's minimum read length (default 70) so they pass the filter.
    // Fully qualified name: it takes priority over the 'FASTP' selector in conf/modules.config,
    // which is included after the profiles.
    withName: 'BARBARAHELENA_OSMOFLOW:OSMOFLOW:FASTP' {
        ext.args = '--cut_right --cut_window_size 4 --cut_mean_quality 15 --length_required 30'
    }
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data: tiny local FASTQ/FASTA fixtures, not real osmo_refdb hits
    input = "${projectDir}/assets/test/samplesheet.csv"
}
